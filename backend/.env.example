# CodeCompass Backend Config
APP_NAME=CodeCompass
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://codecompass:codecompass_secret@localhost:5432/codecompass

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
