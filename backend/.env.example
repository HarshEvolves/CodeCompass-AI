# CodeCompass Backend Config
APP_NAME=CodeCompass
DEBUG=true
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://codecompass:codecompass_secret@localhost:5432/codecompass

# --- JWT Authentication ---
JWT_SECRET_KEY=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- LLM API Keys (RAG AI Chat) ---
# Set at least one key to enable AI RAG search answering
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
# Optional model specifications (defaults shown below)
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini
