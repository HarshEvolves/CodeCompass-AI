# ============================================
# CodeCompass Backend — Environment Variables
# ============================================
# Copy this file to .env and update values as needed.
# NEVER commit .env to version control!

# --- Application ---
APP_NAME=CodeCompass
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS ---
# Frontend URLs that are allowed to make requests to this API.
# Separate multiple origins with commas.
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Database ---
# PostgreSQL Async URL format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://codecompass:codecompass_secret@localhost:5432/codecompass
